generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum ExpenseStatus {
  OPEN
  CLOSE
}

enum SplitStatus {
  PAID
  UNPAID
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  uuid         String   @unique @default(uuid())
  name         String
  passwordHash String
  role         UserRole @default(USER)

  ownedGroups Group[]        @relation("GroupOwner")
  memberships GroupMember[]
  expenses    Expense[]      @relation("ExpensePayer")
  splits      ExpenseSplit[]


  transactionsSent     Transaction[] @relation("TransactionFrom")
  transactionsReceived Transaction[] @relation("TransactionTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Group {
  id      Int    @id @default(autoincrement())
  name    String
  ownerId Int
  uuid    String @unique @default(uuid())

  owner User @relation("GroupOwner", fields: [ownerId], references: [id])

  members  GroupMember[]
  expenses Expense[]

  transactions Transaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model GroupMember {
  id      Int @id @default(autoincrement())
  groupId Int
  uuid    String  @unique @default(uuid())
  userId  Int

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

model Expense {
  id          Int    @id @default(autoincrement())
  uuid        String @unique @default(uuid())
  groupId     Int
  paidById    Int
  description String
  status      ExpenseStatus @default(OPEN)
  amount      BigInt

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User  @relation("ExpensePayer", fields: [paidById], references: [id])

  splits ExpenseSplit[]

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([paidById])
}

model ExpenseSplit {
  id        Int    @id @default(autoincrement())
  uuid      String @unique @default(uuid())
  expenseId Int
  userId    Int
  status    SplitStatus @default(UNPAID)
  amount    BigInt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}


model Transaction {
  id Int @id @default(autoincrement())
  uuid      String @unique @default(uuid())
  groupId    Int
  fromUserId Int
  toUserId   Int
  expenseId  Int

  amount      BigInt
  description String?

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("TransactionFrom", fields: [fromUserId], references: [id])
  toUser   User  @relation("TransactionTo", fields: [toUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
}