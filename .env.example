# Copy this file to .env and fill in real values. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Used directly by the app via DATABASE_URL, and also by docker-compose to
# provision the Postgres container — keep these three in sync with the
# credentials embedded in DATABASE_URL below.
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=geds

# PostgreSQL connection string (used when running the API outside Docker,
# or for `pnpm migrate:deploy` against a container exposed on localhost)
DATABASE_URL="postgresql://user:password@localhost:5432/geds?schema=public"

# Redis (used to store refresh tokens so they can be revoked on logout/rotation)
REDIS_URL=redis://localhost:6379
REDIS_REFRESH_TOKEN_TTL=604800

# JWT secrets — generate strong random values, e.g. `openssl rand -hex 32`
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# How long the refresh-token cookie itself is valid for, in milliseconds
REFRESH_TOKEN_MAX_AGE_MS=604800000

# Allowed origin for browser clients (CORS)
CORS_ORIGIN=http://localhost:3000

# Global rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10
